    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^1.0.12",
    "@upstash/ratelimit": "^2.2.3",
    "@upstash/redis": "^1.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
