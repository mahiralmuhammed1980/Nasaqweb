generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// المرحلة 0: نموذج واحد فقط للتحقق من الاتصال. بقية النماذج تُضاف بـ migrations في المراحل التالية.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  phone         String?
  company       String?
  locale        String    @default("ar")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   OrderRequest[]
  messages ContactMessage[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

// ===== المرحلة 2: كتالوج التطبيقات =====

enum ProductType {
  EXE
  SAAS
  APK
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PriceType {
  FIXED
  FROM
  ON_REQUEST
}

enum VideoProvider {
  YOUTUBE
  BUNNY
}

enum BillingPeriod {
  ONE_TIME
  MONTHLY
  YEARLY
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  products     Product[]
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id         String        @id @default(cuid())
  slug       String        @unique
  type       ProductType
  status     ContentStatus @default(DRAFT)
  categoryId String?
  priceType  PriceType     @default(ON_REQUEST)
  price      Decimal?      @db.Decimal(12, 2)
  currency   String        @default("USD")
  featured   Boolean       @default(false)
  sortOrder  Int           @default(0)
  version    String?
  platforms  String        @default("")
  coverImage String

  demoUrl          String?
  demoUsername     String?
  demoPassword     String?
  demoEmbeddable   Boolean        @default(true)
  videoProvider    VideoProvider?
  videoId          String?
  trialDownloadUrl String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]
  features     ProductFeature[]
  media        ProductMedia[]
  plans        ProductPlan[]
  faqs         ProductFaq[]
  offers       OfferProduct[]
  hardware     HardwareProduct[]
  orders       OrderRequest[]

  @@index([status, featured, sortOrder])
  @@index([type])
  @@index([categoryId])
}

model ProductTranslation {
  id             String   @id @default(cuid())
  productId      String
  locale         String
  name           String
  tagline        String
  description    String   @default("")
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductFeature {
  id        String   @id @default(cuid())
  productId String
  icon      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductFeatureTranslation[]

  @@index([productId, sortOrder])
}

model ProductFeatureTranslation {
  id          String   @id @default(cuid())
  featureId   String
  locale      String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feature ProductFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, locale])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  altAr     String   @default("")
  altEn     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductPlan {
  id            String        @id @default(cuid())
  productId     String
  price         Decimal       @db.Decimal(12, 2)
  billingPeriod BillingPeriod
  highlighted   Boolean       @default(false)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductPlanTranslation[]
  orders       OrderRequest[]

  @@index([productId, sortOrder])
}

model ProductPlanTranslation {
  id        String   @id @default(cuid())
  planId    String
  locale    String
  name      String
  features  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan ProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, locale])
}

model ProductFaq {
  id        String   @id @default(cuid())
  productId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductFaqTranslation[]

  @@index([productId, sortOrder])
}

model ProductFaqTranslation {
  id        String   @id @default(cuid())
  faqId     String
  locale    String
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faq ProductFaq @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
}

// ===== المرحلة 3: العروض والأجهزة =====

enum DiscountType {
  PERCENT
  FIXED
}

model Offer {
  id            String       @id @default(cuid())
  slug          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  bannerImage   String?
  couponCode    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  translations OfferTranslation[]
  products     OfferProduct[]
  orders       OrderRequest[]

  @@index([isActive, startsAt, endsAt])
}

model OfferTranslation {
  id          String   @id @default(cuid())
  offerId     String
  locale      String
  title       String
  description String   @default("")
  terms       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, locale])
}

model OfferProduct {
  offerId   String
  productId String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([productId])
}

model HardwareCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations HardwareCategoryTranslation[]
  hardware     Hardware[]
}

model HardwareCategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category HardwareCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Hardware {
  id         String        @id @default(cuid())
  slug       String        @unique
  categoryId String?
  brand      String
  model      String
  priceType  PriceType     @default(ON_REQUEST)
  price      Decimal?      @db.Decimal(12, 2)
  currency   String        @default("USD")
  inStock    Boolean       @default(true)
  images     String[]
  // مصفوفة {keyAr, keyEn, value}
  specs      Json          @default("[]")
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  category     HardwareCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations HardwareTranslation[]
  products     HardwareProduct[]
  orders       OrderRequest[]

  @@index([status])
  @@index([categoryId])
}

model HardwareTranslation {
  id          String   @id @default(cuid())
  hardwareId  String
  locale      String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@unique([hardwareId, locale])
}

model HardwareProduct {
  hardwareId String
  productId  String

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([hardwareId, productId])
  @@index([productId])
}

// ===== المرحلة 4: الطلبات والتواصل والموافقات =====

enum PreferredChannel {
  WHATSAPP
  PHONE
  EMAIL
}

enum OrderStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
  SPAM
}

enum ActivityType {
  STATUS_CHANGE
  NOTE
  EMAIL_SENT
}

enum MessageStatus {
  NEW
  READ
  HANDLED
}

enum ConsentChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum ConsentSource {
  ONBOARDING
  ORDER_FORM
  CONTACT_FORM
  ACCOUNT
  UNSUBSCRIBE
  ACCOUNT_DELETION
}

model OrderRequest {
  id     String @id @default(cuid())
  // رقم تسلسلي مقروء يبدأ من 1001 (انظر migration)
  number Int    @unique @default(autoincrement())

  productId  String?
  hardwareId String?
  planId     String?
  offerId    String?
  userId     String?

  name             String
  phone            String
  phoneHasWhatsapp Boolean          @default(false)
  email            String?
  company          String?
  city             String?
  country          String?
  preferredChannel PreferredChannel
  message          String?
  status           OrderStatus      @default(NEW)

  locale      String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipHash      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المنتج/الجهاز/الخطة/العرض تبقى مرجعاً اختيارياً: حذفها لا يحذف الطلب التاريخي
  product  Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  hardware Hardware?    @relation(fields: [hardwareId], references: [id], onDelete: SetNull)
  plan     ProductPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  offer    Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  activities RequestActivity[]

  @@index([status, createdAt])
  @@index([productId])
  @@index([hardwareId])
  @@index([createdAt])
}

model RequestActivity {
  id        String       @id @default(cuid())
  requestId String
  type      ActivityType
  payload   Json
  // null للأحداث التي يولّدها النظام (مثل بريد التأكيد التلقائي)
  adminId   String?
  createdAt DateTime     @default(now())

  request OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  userId    String?
  locale    String
  ipHash    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// سجل تاريخي للإضافة فقط: UPDATE وDELETE ممنوعان بمشغّل في قاعدة البيانات (انظر migration).
// userId نص عادي دون علاقة (FK) كي لا يعدّل حذفُ المستخدم السجلَّ القديم.
model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String?
  email         String?
  phone         String?
  channel       ConsentChannel
  granted       Boolean
  source        ConsentSource
  policyVersion Int
  consentText   String
  ipHash        String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  @@index([email, channel, createdAt])
  @@index([phone, channel, createdAt])
  @@index([userId, channel, createdAt])
}
