generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// المرحلة 0: نموذج واحد فقط للتحقق من الاتصال. بقية النماذج تُضاف بـ migrations في المراحل التالية.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
