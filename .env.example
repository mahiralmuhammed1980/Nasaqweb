# ===== الموقع =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # الرابط الأساسي (canonical، sitemap، روابط البريد)
ADMIN_EMAIL=                                  # يصبح مديراً عند الدخول + يستقبل الإشعارات
IP_HASH_SALT=                                 # ملح تجزئة عناوين IP (سلسلة عشوائية طويلة)

# ===== قاعدة البيانات =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nasaq   # اتصال التطبيق (pooled عند الحاجة)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nasaq     # اتصال مباشر للـ migrations

# ===== Auth.js =====
AUTH_SECRET=                                  # سر الجلسات (openssl rand -base64 32). مطلوب للتشغيل المحلي واختبارات E2E
AUTH_GOOGLE_ID=                               # Google OAuth: المزوّد يختفي زره إن لم يُضبط
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=                             # Facebook OAuth
AUTH_FACEBOOK_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=                   # Microsoft Entra ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ===== البريد (Resend) =====
RESEND_API_KEY=                               # مفتاح Resend. بدونه يُطبع رابط الدخول في طرفية الخادم خارج الإنتاج فقط
EMAIL_FROM=                                   # عنوان المرسل المعتمد

# ===== التحليلات (PostHog) =====
NEXT_PUBLIC_POSTHOG_KEY=                      # مفتاح المشروع (لا يُحمَّل قبل موافقة الكوكيز)
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PERSONAL_API_KEY=                     # مفتاح خادم للوحة الإحصاء في الإدارة
POSTHOG_PROJECT_ID=

# ===== التخزين (Cloudflare R2) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=                    # الرابط العام للـ bucket

# ===== الحماية =====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
